#!/bin/sh
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$self_dir/.." && pwd)

: "${WEB_CONTROL_HOME:=${HOME:?HOME is required}}"

if [ -z "${WEB_CONTROL_BROWSER_EXECUTABLE-}" ]
then
  WEB_CONTROL_BROWSER_EXECUTABLE=$(command -v chromium || :)
fi

[ -n "$WEB_CONTROL_BROWSER_EXECUTABLE" ] || {
  printf '%s\n' 'web-control-service: chromium provider command not available' >&2
  exit 1
}

export WEB_CONTROL_HOME WEB_CONTROL_BROWSER_EXECUTABLE
exec node "$root/src/controller.mjs" "$@"
