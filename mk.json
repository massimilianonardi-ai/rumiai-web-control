{
  "version": 2,
  "goals": {
    "check": [
      "check-runtime",
      "check-controller",
      "check-client",
      "check-test",
      "check-build"
    ],
    "test": [
      "test"
    ],
    "build": [
      "build-release"
    ]
  },
  "operations": {
    "check-controller": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/controller.mjs"
        ]
      }
    },
    "check-client": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/client.mjs"
        ]
      }
    },
    "check-test": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "tests/run.mjs"
        ]
      }
    },
    "check-build": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "scripts/build-release.mjs"
        ]
      }
    },
    "test": {
      "prerequisites": [
        "check-controller",
        "check-client",
        "check-test"
      ],
      "action": {
        "type": "process",
        "command": "npm",
        "args": [
          "test"
        ]
      }
    },
    "build-release": {
      "prerequisites": [
        "test",
        "check-build"
      ],
      "outputs": {
        "artifact": {
          "path": "dist/release-artifact"
        }
      },
      "action": {
        "type": "process",
        "command": "npm",
        "args": [
          "run",
          "build"
        ]
      }
    },
    "check-runtime": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/runtime.mjs"
        ]
      }
    }
  }
}
