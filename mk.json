{
  "version": 2,
  "goals": {
    "check": ["check-controller", "check-client", "check-test", "check-build"],
    "test": ["test"],
    "build": ["build-release"]
  },
  "requirements": {
    "nodejs": {
      "type": "facility",
      "facility": "nodejs",
      "constraints": ["=26"]
    }
  },
  "operations": {
    "check-controller": {
      "requirements": ["nodejs"],
      "action": {
        "type": "process",
        "command": "node",
        "args": ["--check", "src/controller.mjs"]
      }
    },
    "check-client": {
      "requirements": ["nodejs"],
      "action": {
        "type": "process",
        "command": "node",
        "args": ["--check", "src/client.mjs"]
      }
    },
    "check-test": {
      "requirements": ["nodejs"],
      "action": {
        "type": "process",
        "command": "node",
        "args": ["--check", "tests/run.mjs"]
      }
    },
    "check-build": {
      "requirements": ["nodejs"],
      "action": {
        "type": "process",
        "command": "node",
        "args": ["--check", "scripts/build-release.mjs"]
      }
    },
    "test": {
      "requirements": ["nodejs"],
      "prerequisites": ["check-controller", "check-client", "check-test"],
      "action": {
        "type": "process",
        "command": "npm",
        "args": ["test"]
      }
    },
    "build-release": {
      "requirements": ["nodejs"],
      "prerequisites": ["test", "check-build"],
      "outputs": {
        "artifact": {
          "path": "dist/release-artifact"
        }
      },
      "action": {
        "type": "process",
        "command": "npm",
        "args": ["run", "build"]
      }
    }
  }
}
